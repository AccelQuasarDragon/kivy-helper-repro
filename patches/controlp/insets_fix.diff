# insets_fix.diff: Bug 1 fix, the status bar overlapping the top app bar at targetSdk 35/36.
# Upstream: yabb85/controlP commit cad5d5c626516dcbf18719194c92e63f06128d62 (branch dev). App dir src/.
# Used by build.yml input `patches` (git apply --verbose in the fetched repo root, before the spec).
# git apply ignores this text before the first "diff --git" line.
# What it does:
# - build() returns an MDBoxLayout (self.root_box) holding self.sm, instead of the MDScreenManager itself.
# - apply_insets() was never called, printed an undefined name and padded self.root (the screen manager).
#   Padding a screen manager has no effect. It now pads root_box.
# - apply_insets() runs at the first frame and again 1 s later (Clock).
# - It logs one line: STUB insets top=.. bottom=.. left=.. right=.. applied=True|False (logcat tag python).
# The rest of the app uses app.sm, never app.root, so nothing else changes.
# Reference: stub_kivymd/stubkit.py read_insets + stub_kivymd/showcase.py apply_insets in this repo.

diff --git a/src/controlp/app.py b/src/controlp/app.py
index ec51ec1..030f4bc 100644
--- a/src/controlp/app.py
+++ b/src/controlp/app.py
@@ -1,3 +1,4 @@
+from kivy.clock import Clock
 from kivy.config import Config
 from kivy.core.window import Window
 from kivy.properties import StringProperty
@@ -90,7 +91,15 @@ class ControlPApp(MDApp):
         self.sm.add_widget(self.play_view)
         self.sm.add_widget(self.other_devices_view)
         self.sm.current = 'home'
-        return self.sm
+        # insets fix: Android 15+ (targetSdk 35+) draws the app under the status / navigation bars.
+        # Padding the MDScreenManager does nothing, so the manager sits in a box that gets the padding;
+        # the rest of the app keeps using self.sm. Insets are read at the first frame and again 1 s
+        # later (the window is fully attached by then).
+        self.root_box = MDBoxLayout()
+        self.root_box.add_widget(self.sm)
+        Clock.schedule_once(lambda dt: self.apply_insets(), 0)
+        Clock.schedule_once(lambda dt: self.apply_insets(), 1)
+        return self.root_box
 
     def build_config(self, config):
         config.setdefaults('pioneer',
@@ -114,10 +123,12 @@ class ControlPApp(MDApp):
         self.network_player = network_player
 
     def apply_insets(self) -> None:
-        # always READ (the logged numbers measure the overlap even with padding off); PAD only when `insets`
+        # read the system bar insets (px); pad the root box by them when they are readable
         ins = read_insets()
         top, bottom, left, right = ins if ins is not None else ('n/a',) * 4
-        self.root.padding = [left, top, right, bottom]  # Kivy padding = left, top, right, bottom
+        applied = ins is not None
+        if applied:
+            self.root_box.padding = [left, top, right, bottom]  # Kivy padding = left, top, right, bottom
         print(f'STUB insets top={top} bottom={bottom} left={left} right={right} applied={applied}')
 
 
